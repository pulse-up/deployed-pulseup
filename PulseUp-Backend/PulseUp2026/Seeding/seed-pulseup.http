# Select `local` for local MySQL or `deployed` for the Render/TiDB HTTPS API.
# baseUrl and passwords come from IntelliJ HTTP environments. Passwords stay
# in ignored http-client.private.env.json; JWTs are captured at runtime.
# Production registration is not idempotent: verify the deployed database is
# empty before running steps 2-12.
#
# ADMIN BOOTSTRAP RECORD
# Created once by AdminBootstrap when Spring Boot starts with
# PULSEUP_BOOTSTRAP_ADMIN_ENABLED=true.
# Name: Tiyani Ngwana
# Email: pulseadmin@cput.ac.za
# Phone: 0600000001 (local seed placeholder)
# Admin number: ADM-LOCAL-001
# Department: System Administration
# Password source: PULSEUP_BOOTSTRAP_ADMIN_PASSWORD in the IntelliJ Run
# Configuration; use the same value as {{adminPassword}} in the ignored
# http-client.private.env.json file. Never commit the plaintext password.

### 1. Sign in as the bootstrapped administrator and generate the slot date
< {%
  const slotDate = new Date();
  slotDate.setDate(slotDate.getDate() + 30);
  const year = slotDate.getFullYear();
  const month = String(slotDate.getMonth() + 1).padStart(2, "0");
  const day = String(slotDate.getDate()).padStart(2, "0");
  client.global.set("seedSlotDate", `${year}-${month}-${day}`);
%}
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
  client.test("Admin login returns a JWT", function () {
    client.assert(response.status === 200, `Expected 200, received ${response.status}`);
    client.assert(Boolean(response.body.token), "Login response did not include a token");
  });
  client.global.set("adminToken", response.body.token);
%}

### 2. Register General Consultations staff
POST {{baseUrl}}/api/auth/register/staff
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
  "email": "230126634@cput.ac.za",
  "password": "{{staffPassword}}",
  "firstName": "Inga",
  "lastName": "Plati",
  "phoneNumber": "0608920131",
  "staffNumber": "230126634",
  "department": "General Consultations",
  "position": "General Practitioner",
  "specialization": "Primary health care"
}

> {%
  client.test("Inga profile fields were captured", function () {
    client.assert(response.status === 201, `Expected 201, received ${response.status}`);
    client.assert(response.body.phoneNumber === "0608920131", "Phone number mismatch");
    client.assert(response.body.department === "General Consultations", "Department mismatch");
    client.assert(response.body.position === "General Practitioner", "Position mismatch");
    client.assert(response.body.specialization === "Primary health care", "Specialization mismatch");
    client.assert(response.body.availabilityStatus === "AVAILABLE", "Availability mismatch");
  });
  client.global.set("generalConsultationsStaffId", response.body.userId);
%}

