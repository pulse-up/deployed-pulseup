### 7. Verify all created staff records
GET {{baseUrl}}/api/staff
Accept: application/json
Authorization: Bearer {{adminToken}}

> {%
  client.test("All dashboard staff profiles are available", function () {
    const expectedEmails = [
      "230126634@cput.ac.za",
      "240443608@cput.ac.za",
      "218123191@cput.ac.za",
      "222527269@cput.ac.za",
      "230541844@cput.ac.za"
    ];
    expectedEmails.forEach((email) => {
      const staff = response.body.find((item) => item.email === email);
      client.assert(Boolean(staff), `Missing staff record: ${email}`);
      client.assert(Boolean(staff.phoneNumber), `Missing phone number: ${email}`);
      client.assert(Boolean(staff.department), `Missing department: ${email}`);
      client.assert(Boolean(staff.position), `Missing position: ${email}`);
      client.assert(Boolean(staff.specialization), `Missing specialization: ${email}`);
    });
  });
%}

### 8. Create General Consultations slot
POST {{baseUrl}}/api/time-slots
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
  "staffId": {{generalConsultationsStaffId}},
  "slotDate": "{{seedSlotDate}}",
  "startTime": "09:00",
  "endTime": "09:20",
  "appointmentType": "General Consultations",
  "roomNumber": "Unit A1",
  "estimatedDurationMinutes": 20
}

